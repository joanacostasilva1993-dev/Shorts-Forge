# .env.example — shorts-forge
# ============================================================
# Cópia de exemplo: duplica para `.env` e preenche as tuas chaves.
# NUNCA commits `.env` real (está no .gitignore).
# Valores aqui são só marcadores de posição — nunca chaves reais.

# ------------------------------------------------------------
# LLM — router de providers gratuitos (packages/llm-router)
# ------------------------------------------------------------
# Ordem da cadeia de failover, separada por vírgulas.
# Ordem por omissão (não precisas definir se não quiseres mudar):
#   gemini,groq,openrouter,mistral,cerebras,github-models,pollinations,ollama
# Providers sem chave são saltados automaticamente — sem chaves,
# a cadeia efetiva é pollinations → ollama (funciona sem configuração).
LLM_PROVIDERS=gemini,groq,openrouter,mistral,cerebras,github-models,pollinations,ollama

# Chaves de API (todas opcionais e gratuitas; obtém-nas nos respetivos sites).
# Providers SEM chave definida são saltados em silêncio pelo router.
GEMINI_API_KEY=cola-aqui-a-tua-chave
GROQ_API_KEY=cola-aqui-a-tua-chave
OPENROUTER_API_KEY=cola-aqui-a-tua-chave
MISTRAL_API_KEY=cola-aqui-a-tua-chave
CEREBRAS_API_KEY=cola-aqui-a-tua-chave
GITHUB_TOKEN=cola-aqui-a-tua-chave

# Timeout (ms) por tentativa de chat no router. Omisso: 60000.
LLM_TIMEOUT_MS=60000

# NOTA: pollinations e ollama são keyless — não precisam de chave.
# Ollama usa OLLAMA_BASE_URL abaixo (servidor local).

# ------------------------------------------------------------
# B-roll — stock footage (pacote video; Fase 4)
# ------------------------------------------------------------
# Opcional: sem chaves, o pipeline usa imagens locais (Ken Burns)
# ou fundo gerado. Pexels/Pixabay têm tier gratuito.
PEXELS_API_KEY=cola-aqui-a-tua-chave
PIXABAY_API_KEY=cola-aqui-a-tua-chave

# ------------------------------------------------------------
# Pipeline — voz e transcrição (Fase 2)
# ------------------------------------------------------------
# Modelo faster-whisper para transcrição (opções típicas: tiny, base,
# small, medium). Sacado pelo script models:download.
WHISPER_MODEL=small

# Voz Kokoro para narração (nome da voz no catálogo Kokoro-82M).
# Verificado na Fase 2: as únicas vozes portuguesas do Kokoro-82M são pt-BR
# (pf_dora feminina; pm_alex e pm_santa masculinas). NÃO há voz pt-PT nativa
# — para pt-PT europeu, usa o provider edge-tts (pt-PT-DuarteNeural /
# pt-PT-RaquelNeural) ou google. Ver packages/tts/samples/VOICES.md.
KOKORO_VOICE=pf_dora

# Voz Edge-TTS para narração pt-PT (ex.: pt-PT-DuarteNeural).
# Só é usada com TTS_ENGINE=edge-tts. Vazia = voz por omissão do serviço.
EDGE_TTS_VOICE=

# Velocidade de fala do TTS (1.0 = normal; 0.9 mais lento, 1.1 mais rápido).
SPEECH_RATE=1.0

# Motor de TTS (kokoro = local, gratuito, omissão; edge-tts = fallback grátis;
# google = Google Cloud TTS, precisa de credenciais — ver secção abaixo).
# Motores pagos nunca são requisito — política free-only em ARCHITECTURE.md §9.
TTS_ENGINE=kokoro

# ------------------------------------------------------------
# Google Cloud TTS (provider opcional first-class; Fase 2)
# ------------------------------------------------------------
# Alternativa cloud com vozes pt-PT de alta qualidade. Tem um tier grátis
# mensal generoso (os valores mudam — confirma na página de preços da Google
# no momento do build). Nunca no caminho crítico: sem credenciais, o pipeline
# usa Kokoro/Edge-TTS.
# Autenticação: escolhe UMA das duas formas (precedência: service account).
#   1) GOOGLE_APPLICATION_CREDENTIALS — caminho do JSON da service account
#      (recomendado se já usas Google Cloud; obtém em Console → IAM e contas
#      de serviço, com a Cloud Text-to-Speech API ativada no projeto).
#   2) GOOGLE_TTS_API_KEY — chave de API simples (Console → APIs e serviços →
#      Credenciais). Suficiente para o TTS; a forma mais rápida de começar.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
GOOGLE_TTS_API_KEY=cola-aqui-a-tua-chave

# Voz Google Cloud TTS (nome exato, ex.: pt-PT-Neural2-A).
# Confirmar os nomes exatos em GET /v1/voices?languageCode=pt-PT na Fase 2
# (ver docs/tts-providers.md §2 — os nomes aqui são exemplos).
GOOGLE_TTS_VOICE=pt-PT-Neural2-A

# ------------------------------------------------------------
# App — porta local (contrato congelado ARCHITECTURE.md §8)
# ------------------------------------------------------------
# A UI e a API do pipeline servem na MESMA porta e origem:
# base http://localhost:3000/api. O cliente da UI
# (packages/ui/src/lib/api.ts) tem este endereço fixo — esta porta
# NÃO pode mudar sem quebrar a UI.
# (lida por packages/pipeline/src/server.ts; omissão 3000)
PIPELINE_API_PORT=3000

# Base URL do Ollama local (backstop final do router + modo "Ollama local").
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Overrides avançados do router de LLMs (opcional)
# ------------------------------------------------------------
# O router suporta overrides por provider via variáveis de ambiente:
#   <NOME>_MODEL    — modelo a usar (ex.: GROQ_MODEL=llama-3.3-70b-versatile)
#   <NOME>_BASE_URL — endpoint alternativo (ex.: OLLAMA_BASE_URL chega;
#                    para outros: GROQ_BASE_URL=https://...)
#   <NOME>_PRIORITY — prioridade na cadeia de failover (número; menor = primeiro)
# <NOME> é o nome do provider em maiúsculas: GEMINI, GROQ, OPENROUTER,
# MISTRAL, CEREBRAS, GITHUB_MODELS, POLLINATIONS, OLLAMA.
# Exemplos (descomentar para usar):
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=qwen3:8b
# LLM_TIMEOUT_MS=60000
